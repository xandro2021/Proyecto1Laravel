### ========================================
### OFFICELEND API - Laravel
### ========================================

@baseUrl = http://127.0.0.1:8000/api

# Reemplazar después del login
@token = 31|YZxLm44ZA1I1ONXX5RAwMUPuFWKd9EbbsVDHLXatbacee558

# Cambiar entre:
# es -> Español
# en -> English
@lang = en


### ========================================
### AUTH
### ========================================

### Login ADMIN
POST {{baseUrl}}/login
Content-Type: application/json
Accept: application/json
Accept-Language: {{lang}}

{
    "username": "admin",
    "password": "admin"
}

###

### Login USER
POST {{baseUrl}}/login
Content-Type: application/json
Accept: application/json
Accept-Language: {{lang}}

{
    "username": "user",
    "password": "user"
}

###

### Login inválido (probar i18n)
POST {{baseUrl}}/login
Content-Type: application/json
Accept: application/json
Accept-Language: {{lang}}

{
    "username": "fake",
    "password": "wrong"
}

###

### Register
POST {{baseUrl}}/register
Content-Type: application/json
Accept: application/json
Accept-Language: {{lang}}

{
    "username": "jdoe",
    "email": "jdoe@test.com",
    "password": "123456",
    "full_name": "John Doe",
    "role": "USER"
}

###

### Logout
POST {{baseUrl}}/logout
Authorization: Bearer {{token}}
Accept: application/json
Accept-Language: {{lang}}


### ========================================
### EQUIPMENT
### ========================================

### Obtener todos
GET {{baseUrl}}/equipment
Authorization: Bearer {{token}}
Accept: application/json
Accept-Language: {{lang}}

###

### Obtener por ID
GET {{baseUrl}}/equipment/6
Authorization: Bearer {{token}}
Accept: application/json
Accept-Language: {{lang}}

###

### Crear equipo SIN imagen
POST {{baseUrl}}/equipment
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json
Accept-Language: {{lang}}

{
    "name": "Laptop Dell XPS",
    "type": "Laptop",
    "description": "Laptop de alto rendimiento",
    "stock": 5,
    "status": "DISPONIBLE"
}

###

### Crear equipo CON imagen
POST {{baseUrl}}/equipment
Authorization: Bearer {{token}}
Accept: application/json
Accept-Language: {{lang}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="name"

Laptop Lenovo
--boundary
Content-Disposition: form-data; name="type"

Laptop
--boundary
Content-Disposition: form-data; name="description"

Laptop empresarial
--boundary
Content-Disposition: form-data; name="stock"

10
--boundary
Content-Disposition: form-data; name="status"

DISPONIBLE
--boundary
Content-Disposition: form-data; name="image"; filename="test.jpg"
Content-Type: image/jpeg

< ./test.jpg
--boundary--

###

### Actualizar equipo
PUT {{baseUrl}}/equipment/9
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json
Accept-Language: {{lang}}

{
    "name": "Thinkpad T14",
    "type": "Laptop",
    "description": "Actualizada",
    "stock": 7,
    "status": "OCUPADO"
}

###

### Eliminar equipo
DELETE {{baseUrl}}/equipment/10
Authorization: Bearer {{token}}
Accept: application/json
Accept-Language: {{lang}}


### ========================================
### LOANS
### ========================================

### Obtener todos
GET {{baseUrl}}/loans
Authorization: Bearer {{token}}
Accept: application/json
Accept-Language: {{lang}}

###

### Obtener préstamo
GET {{baseUrl}}/loans/1
Authorization: Bearer {{token}}
Accept: application/json
Accept-Language: {{lang}}

###

### Obtener mis préstamos
GET {{baseUrl}}/loans/my
Authorization: Bearer {{token}}
Accept: application/json
Accept-Language: {{lang}}

###

### Crear préstamo
POST {{baseUrl}}/loans
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json
Accept-Language: {{lang}}

{
    "estimated_end_date": "2026-05-30",
    "justification": "Necesario para trabajo remoto",
    "equipment_id": 7
}

###

### Crear préstamo inválido (fecha pasada)
POST {{baseUrl}}/loans
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json
Accept-Language: {{lang}}

{
    "estimated_end_date": "2020-01-01",
    "justification": "Testing invalid range",
    "equipment_id": 6
}

###

### Actualizar préstamo -> APROBADO
PUT {{baseUrl}}/loans/1
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json
Accept-Language: {{lang}}

{
    "status": "APROBADO"
}

###

### Actualizar préstamo -> PRESTADO
PUT {{baseUrl}}/loans/1
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json
Accept-Language: {{lang}}

{
    "status": "PRESTADO"
}

###

### Actualizar préstamo -> DEVUELTO
PUT {{baseUrl}}/loans/2
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json
Accept-Language: {{lang}}

{
    "status": "DEVUELTO"
}

###

### Transición inválida
PUT {{baseUrl}}/loans/1
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json
Accept-Language: {{lang}}

{
    "status": "PENDIENTE"
}

###

### Eliminar préstamo
DELETE {{baseUrl}}/loans/1
Authorization: Bearer {{token}}
Accept: application/json
Accept-Language: {{lang}}


### ========================================
### USERS
### ========================================

### Obtener usuarios
GET {{baseUrl}}/users
Authorization: Bearer {{token}}
Accept: application/json
Accept-Language: {{lang}}

###

### Obtener usuario
GET {{baseUrl}}/users/3
Authorization: Bearer {{token}}
Accept: application/json
Accept-Language: {{lang}}

###

### Crear usuario
POST {{baseUrl}}/users
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json
Accept-Language: {{lang}}

{
    "username": "nuevo",
    "email": "nuevo@test.com",
    "password": "12345678",
    "role": "USER",
    "full_name": "Nuevo Usuario"
}

###

### Actualizar usuario
PUT {{baseUrl}}/users/5
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json
Accept-Language: {{lang}}

{
    "full_name": "Usuario Actualizado"
}

###

### Eliminar usuario
DELETE {{baseUrl}}/users/3
Authorization: Bearer {{token}}
Accept: application/json
Accept-Language: {{lang}}
