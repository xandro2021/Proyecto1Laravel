### ========================================
### OFFICELEND API - Laravel
### ========================================

@baseUrl = http://127.0.0.1:8000/api

# Reemplazar después del login
@token = TU_TOKEN_AQUI

# Idiomas:
# es -> Español
# en -> Inglés

@langEs = es
@langEn = en


### ========================================
### AUTH
### ========================================

### Login ADMIN (ES)
POST {{baseUrl}}/login
Content-Type: application/json
Accept: application/json
Accept-Language: {{langEs}}

{
    "username": "admin",
    "password": "admin"
}

###

### Login ADMIN (EN)
POST {{baseUrl}}/login
Content-Type: application/json
Accept: application/json
Accept-Language: {{langEn}}

{
    "username": "admin",
    "password": "admin"
}

###

### Login USER
POST {{baseUrl}}/login
Content-Type: application/json
Accept: application/json
Accept-Language: {{langEs}}

{
    "username": "user",
    "password": "user"
}

###

### Login inválido (probar i18n)
POST {{baseUrl}}/login
Content-Type: application/json
Accept: application/json
Accept-Language: {{langEn}}

{
    "username": "fake",
    "password": "wrong"
}

###

### Register
POST {{baseUrl}}/register
Content-Type: application/json
Accept: application/json
Accept-Language: {{langEs}}

{
    "username": "jdoe",
    "email": "jdoe@test.com",
    "password": "123456",
    "full_name": "John Doe",
    "role": "USER"
}

###

### Logout
POST {{baseUrl}}/logout
Authorization: Bearer {{token}}
Accept: application/json
Accept-Language: {{langEs}}


### ========================================
### EQUIPMENT
### ========================================

### Obtener todos
GET {{baseUrl}}/equipment
Authorization: Bearer {{token}}
Accept: application/json
Accept-Language: {{langEs}}

###

### Obtener todos (EN)
GET {{baseUrl}}/equipment
Authorization: Bearer {{token}}
Accept: application/json
Accept-Language: {{langEn}}

###

### Obtener por ID
GET {{baseUrl}}/equipment/1
Authorization: Bearer {{token}}
Accept: application/json
Accept-Language: {{langEs}}

###

### Crear equipo SIN imagen
POST {{baseUrl}}/equipment
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json
Accept-Language: {{langEs}}

{
    "name": "Laptop Dell XPS",
    "type": "Laptop",
    "description": "Laptop de alto rendimiento",
    "stock": 5,
    "status": "DISPONIBLE"
}

###

### Crear equipo SIN imagen (EN)
POST {{baseUrl}}/equipment
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json
Accept-Language: {{langEn}}

{
    "name": "MacBook Pro",
    "type": "Laptop",
    "description": "High performance laptop",
    "stock": 3,
    "status": "DISPONIBLE"
}

###

### Crear equipo CON imagen
POST {{baseUrl}}/equipment
Authorization: Bearer {{token}}
Accept: application/json
Accept-Language: {{langEs}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="name"

Laptop Lenovo
--boundary
Content-Disposition: form-data; name="type"

Laptop
--boundary
Content-Disposition: form-data; name="description"

Laptop empresarial
--boundary
Content-Disposition: form-data; name="stock"

10
--boundary
Content-Disposition: form-data; name="status"

DISPONIBLE
--boundary
Content-Disposition: form-data; name="image"; filename="test.jpg"
Content-Type: image/jpeg

< ./test.jpg
--boundary--

###

### Actualizar equipo
PUT {{baseUrl}}/equipment/1
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json
Accept-Language: {{langEs}}

{
    "name": "Thinkpad T14",
    "type": "Laptop",
    "description": "Actualizada",
    "stock": 7,
    "status": "OCUPADO"
}

###

### Actualizar equipo (EN)
PUT {{baseUrl}}/equipment/1
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json
Accept-Language: {{langEn}}

{
    "name": "Thinkpad T14 Gen 5",
    "type": "Laptop",
    "description": "Updated version",
    "stock": 8,
    "status": "DISPONIBLE"
}

###

### Eliminar equipo
DELETE {{baseUrl}}/equipment/1
Authorization: Bearer {{token}}
Accept: application/json
Accept-Language: {{langEs}}

###

### Eliminar equipo (EN)
DELETE {{baseUrl}}/equipment/2
Authorization: Bearer {{token}}
Accept: application/json
Accept-Language: {{langEn}}


### ========================================
### LOANS
### ========================================

### Obtener todos
GET {{baseUrl}}/loans
Authorization: Bearer {{token}}
Accept: application/json
Accept-Language: {{langEs}}

###

### Obtener préstamo
GET {{baseUrl}}/loans/1
Authorization: Bearer {{token}}
Accept: application/json
Accept-Language: {{langEs}}

###

### Obtener mis préstamos
GET {{baseUrl}}/my-loans
Authorization: Bearer {{token}}
Accept: application/json
Accept-Language: {{langEs}}

###

### Crear préstamo
POST {{baseUrl}}/loans
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json
Accept-Language: {{langEs}}

{
    "estimated_end_date": "2026-05-30",
    "justification": "Necesario para trabajo remoto",
    "equipment_id": 1
}

###

### Crear préstamo (EN)
POST {{baseUrl}}/loans
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json
Accept-Language: {{langEn}}

{
    "estimated_end_date": "2026-05-30",
    "justification": "Needed for remote work",
    "equipment_id": 1
}

###

### Crear préstamo inválido (fecha pasada)
POST {{baseUrl}}/loans
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json
Accept-Language: {{langEn}}

{
    "estimated_end_date": "2020-01-01",
    "justification": "Testing invalid range",
    "equipment_id": 1
}

###

### Actualizar préstamo -> APROBADO
PUT {{baseUrl}}/loans/1
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json
Accept-Language: {{langEs}}

{
    "status": "APROBADO"
}

###

### Actualizar préstamo -> PRESTADO
PUT {{baseUrl}}/loans/1
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json
Accept-Language: {{langEs}}

{
    "status": "PRESTADO"
}

###

### Actualizar préstamo -> DEVUELTO
PUT {{baseUrl}}/loans/1
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json
Accept-Language: {{langEn}}

{
    "status": "DEVUELTO"
}

###

### Transición inválida
PUT {{baseUrl}}/loans/1
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json
Accept-Language: {{langEn}}

{
    "status": "PENDIENTE"
}

###

### Eliminar préstamo
DELETE {{baseUrl}}/loans/1
Authorization: Bearer {{token}}
Accept: application/json
Accept-Language: {{langEs}}


### ========================================
### USERS
### ========================================

### Obtener usuarios
GET {{baseUrl}}/users
Authorization: Bearer {{token}}
Accept: application/json
Accept-Language: {{langEs}}

###

### Obtener usuario
GET {{baseUrl}}/users/3
Authorization: Bearer {{token}}
Accept: application/json
Accept-Language: {{langEs}}

###

### Crear usuario
POST {{baseUrl}}/users
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json
Accept-Language: {{langEs}}

{
    "username": "nuevo",
    "email": "nuevo@test.com",
    "password": "12345678",
    "role": "USER",
    "full_name": "Nuevo Usuario"
}

###

### Actualizar usuario
PUT {{baseUrl}}/users/5
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json
Accept-Language: {{langEs}}

{
    "full_name": "Usuario Actualizado"
}

###

### Eliminar usuario
DELETE {{baseUrl}}/users/3
Authorization: Bearer {{token}}
Accept: application/json
Accept-Language: {{langEn}}
